  m_text: "\uC0C8 \uAC8C\uC784\uC744 \uC2DC\uC791\uD558\uBA74 \uD604\uC7AC \uC9C4\uD589\uACFC
    \uC790\uB3D9 \uC800\uC7A5 8\uAC1C, \uC218\uB3D9 \uC800\uC7A5\uC744 \uCD08\uAE30\uD654\uD569\uB2C8\uB2E4.\n\uAE30\uBCF8
    \uC800\uC7A5\uACFC \uBC31\uC5C5\uB3C4 \uCD08\uAE30\uD654\uB418\uBA70, \uC601\uAD6C
    \uBC31\uC5C5\uC740 \uBCF4\uC7A5\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\n\uB2E4\uB978
